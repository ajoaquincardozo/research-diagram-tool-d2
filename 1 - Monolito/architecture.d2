vars: {
  d2-config: {
    theme-id: 200
  }
}

direction: right

title: Arquitectura Monolítica {
  near: top-center
  shape: text
  style: {
    font-size: 24
    bold: true
  }
}

# Usuario
user: Usuario {
  shape: person
}

# Aplicación Monolítica
app: Aplicación Monolítica {
  shape: rectangle
  style: {
    fill: "#5c6bc0"
    stroke: "#9fa8da"
    stroke-width: 3
  }
}

# Base de Datos
db: Base de Datos {
  shape: cylinder
  style: {
    fill: "#ffd54f"
    stroke: "#ffb300"
    font-color: "#1a1a1a"
  }
}

# Almacenamiento de Archivos
storage: Almacenamiento de Archivos {
  shape: stored_data
}

# Conexiones
user -> app: HTTP/HTTPS
app -> db: SQL
app -> storage: Archivos
